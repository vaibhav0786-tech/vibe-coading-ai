# =========================================================
# Vibe Coding AI - Environment Configuration
# =========================================================

# Runtime mode
APP_ENV=development

# Gateway
APP_HOST=127.0.0.1
APP_PORT=9000

# Model provider
MODEL_PROVIDER=ollama

# Local Ollama endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Cloud Ollama endpoint - fill this in later
# Example:
# OLLAMA_CLOUD_URL=http://YOUR_CLOUD_IP:11434
OLLAMA_CLOUD_URL=

# Which endpoint the gateway should use
MODEL_ENDPOINT=local

# Installed local model. Vision routing remains disabled in the registry.
CODING_MODEL=qwen2.5-coder:7b
REASONING_MODEL=qwen2.5-coder:7b
VISION_MODEL=qwen2.5-coder:7b

# Request limits
REQUEST_TIMEOUT_SECONDS=600

# Logging
LOG_LEVEL=INFO
